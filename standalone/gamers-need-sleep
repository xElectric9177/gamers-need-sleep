#!/bin/bash
# Launcher for the standalone Gamers Need Sleep app. Runs the shared Quickshell
# bundle (shell.qml beside its ui/ and core/). Finds the bundle in the usual
# install locations, or a local dev build.
set -euo pipefail

candidates=()
[[ -n "${GNS_SHARE_DIR:-}" ]] && candidates+=("$GNS_SHARE_DIR/app/shell.qml")
candidates+=(
  "$HOME/.local/share/gamers-need-sleep/app/shell.qml"
  "/usr/local/share/gamers-need-sleep/app/shell.qml"
  "/usr/share/gamers-need-sleep/app/shell.qml"
)
# Dev fallbacks when run from a checkout (build/app or a repo-root assembly).
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
candidates+=(
  "$HERE/../build/app/shell.qml"
  "$HERE/../app/shell.qml"
)

CONFIG=""
for c in "${candidates[@]}"; do
  if [[ -f "$c" ]]; then CONFIG="$c"; break; fi
done

if [[ -z "$CONFIG" ]]; then
  echo "gamers-need-sleep: could not find shell.qml. Run ./install.sh (or ./install.sh --dev)." >&2
  exit 1
fi

if ! command -v qs >/dev/null 2>&1; then
  echo "gamers-need-sleep: quickshell (qs) is not installed." >&2
  exit 1
fi

exec qs -p "$CONFIG" "$@"
